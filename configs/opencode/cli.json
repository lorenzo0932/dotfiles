{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto",
    "tree": true
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "low",
    "new_location": "launch",
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "mode": "auto",
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "status"
  },
  "prompt": {
    "paste": "compact",
    "image_preview": true
  },
  "attention": {
    "notifications": true,
    "sound": true
  }
}
