{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "small_model": "opencode/muse-spark-1.3-contributor-free",
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "description": "Agente principale di sviluppo (42/42 nel benchmark)"
    },
    "plan": {
      "mode": "primary",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "temperature": 0.1,
      "description": "Analisi e piani senza modifiche"
    },
    "explore": {
      "mode": "subagent",
      "description": "Multi-file codebase mapping, file search by pattern, keyword search. Read-only, cannot edit. Always end with a text summary including path:riga citations."
    },
    "scout": {
      "mode": "subagent",
      "description": "External docs and dependency research, read-only. Use for upstream/library cross-check without touching workspace."
    }
  }
}
