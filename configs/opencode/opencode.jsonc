{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    }
  },
  "agents": {
    "title": {
      "model": "opencode/deepseek-v4.1-flash-free"
    },
    "build": {
      "mode": "primary",
      "description": "Agente principale di sviluppo"
    },
    "plan": {
      "mode": "primary",
      "temperature": 0.1,
      "description": "Analisi e piani senza modifiche"
    },
    "explore": {
      "mode": "subagent",
      "description": "Esplorazione multi-file del codebase (ricerca per pattern o parole chiave). Sola lettura imposta: edit e shell disabilitati. Termina sempre con un riassunto testuale con citazioni path:riga.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },
    "scout": {
      "mode": "subagent",
      "description": "Ricerca di documentazione e dipendenze esterne. Sola lettura sul workspace: edit, shell e lancio di sottoagenti disabilitati; restano lettura file e web fetch/search.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
