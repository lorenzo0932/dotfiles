{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "small_model": "ollama/qwen35-9b-64k",
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "opencode/big-pickle",
      "description": "Agente principale di sviluppo (42/42 nel benchmark)"
    },
    "plan": {
      "mode": "primary",
      "model": "opencode/big-pickle",
      "temperature": 0.1,
      "description": "Analisi e piani senza modifiche"
    },
    "explore": {
      "mode": "subagent",
      "model": "ollama/qwen35-9b-64k",
      "temperature": 0.1,
      "description": "Esplorazione read-only velocissima della codebase (locale, 64k ctx)"
    },
    "scout": {
      "mode": "subagent"
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen35-9b-64k": {
          "name": "Qwen3.5 9B 64k (locale default, unico con fix reale nel bench)"
        },
        "gpt-oss:20b": {
          "name": "gpt-oss 20B (NON usare via opencode: adapter rotto; solo via API diretta o futura fase llama-server)"
        }
      }
    }
  }
}
