{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",
  "small_model": "opencode-go/deepseek-v4-flash",
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "agent": {
    "explore": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "scout": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "plan": {
      "model": "opencode-go/glm-5.2",
      "steps": 40
    },
    "build": {
      "steps": 60
    }
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "code *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls*": "allow",
      "pwd": "allow"
    }
  }
}
