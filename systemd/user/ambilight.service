[Unit]
Description=Ambilight: LED sigue colori schermo (ScreenCast daemon)
After=graphical-session.target

[Service]
Type=simple
EnvironmentFile=%h/.config/mqtt.env
ExecStart=/usr/bin/python3 /home/lorenzo/.local/share/myScript/GameMode/screenshot_portal.py daemon
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
TimeoutStopSec=30

[Install]
WantedBy=default.target 