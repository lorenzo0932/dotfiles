[Unit]
Description=Ambilight: LED sigue colori schermo (ScreenCast daemon)
After=graphical-session.target

[Service]
Type=simple
EnvironmentFile=%h/.config/mqtt.env
ExecStartPre=/bin/bash -c 'mosquitto_pub -h 192.168.1.39 -u "${MQTT_USER:-lorenzo}" -P "$MQTT_PASS" -t fedora/light/start -m 1'
ExecStart=/usr/bin/python3 /home/lorenzo/.local/share/myScript/GameMode/screenshot_portal.py daemon
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
TimeoutStopSec=30

[Install]
WantedBy=default.target