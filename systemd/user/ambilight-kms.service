[Unit]
Description=Ambilight KMS: LED segue colori schermo senza prompt portal
After=graphical-session.target

[Service]
Type=simple
EnvironmentFile=%h/.config/mqtt.env
ExecStart=/usr/bin/python3 /home/lorenzo/.local/share/myScript/GameMode/screenshot_portal.py daemon --backend=kms
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
TimeoutStopSec=30

[Install]
WantedBy=default.target
