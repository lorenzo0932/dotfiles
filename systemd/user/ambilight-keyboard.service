[Unit]
Description=Ambilight tastiera: Drevo Tyrfing V2 segue i colori schermo (MQTT)
After=graphical-session.target

[Service]
Type=simple
ExecStart=/home/lorenzo/.local/venvs/dtv2/bin/python3 /home/lorenzo/.local/share/myScript/GameMode/drevo_keyboard_sync.py
Restart=on-failure
RestartSec=5
